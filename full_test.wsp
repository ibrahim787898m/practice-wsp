    no:
        tell me "Game in progress"

# Loop
do 3 times:
    increase score by 5
    the hero gains 2 power

show "Score: " + score
show "Hero: " + hero

# When/otherwise
when score greater than 20:
    tell me "High score!"
otherwise:
    tell me "Keep playing"

# Function
